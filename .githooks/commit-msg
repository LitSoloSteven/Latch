#!/bin/sh
root=$(git rev-parse --show-toplevel) || exit 1
if command -v pwsh >/dev/null 2>&1; then
  pwsh -NoProfile -File "$root/scripts/check-policy.ps1" -CommitMessageFile "$1"
else
  powershell.exe -NoProfile -ExecutionPolicy Bypass -File "$root/scripts/check-policy.ps1" -CommitMessageFile "$1"
fi
